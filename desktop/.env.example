# CasaPad Mac — notarize / Developer ID (non commitare valori reali)
# Copia in desktop/.env  oppure esporta in shell prima di:
#   bash scripts/desktop-notarize-dmg.sh

# Team (default YSU7PL673A — AGENTS.md / mobile)
APPLE_TEAM_ID=YSU7PL673A

# Opzione A — Apple ID + app-specific password (account.apple.com)
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
# Alias letto da Tauri dopo mapping nello script:
# APPLE_PASSWORD=

# Opzione B — App Store Connect API (stesso layout di TestFlight)
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_PATH=/Users/YOU/.app-store/asc-api/AuthKey_XXXXXX.p8
# Alias anche accettati:
# APP_STORE_CONNECT_API_KEY_ID=
# APP_STORE_CONNECT_API_ISSUER_ID=
# APP_STORE_CONNECT_API_KEY_PATH=

# Identity opzionale (altrimenti lo script cerca "Developer ID Application")
# APPLE_SIGNING_IDENTITY=Developer ID Application: Nome Cognome (YSU7PL673A)
# TAURI_SIGNING_IDENTITY=
