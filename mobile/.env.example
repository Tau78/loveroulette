# Host pubblico della web app (senza slash finale).
# Default: https://loveroulette.vercel.app (serata live). Non usare love-roulette.vercel.app (altra app).
EXPO_PUBLIC_APP_URL=https://loveroulette.vercel.app

# Team Apple (stesso di ReWavier / MusicPro Eventi)
EXPO_APPLE_TEAM_ID=YSU7PL673A

# Chiave API App Store Connect (una per tutto il team Individual).
# Non committare .p8. Default sul Mac: ~/.app-store/asc-api/key.env
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_KEY_PATH=
